    "requestXml": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:web=\"http://www.oorsprong.org/websamples.countryinfo\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <web:ListOfCountryNamesByCode/>\n   </soapenv:Body>\n</soapenv:Envelope>",
    "authType": "BASIC",
    "username": "demo",
    "password": "demo",
    "connectTimeoutSeconds": 30,
    "readTimeoutSeconds": 30
  }
}