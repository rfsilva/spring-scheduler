{
  "name": "SOAP API Pública com Auth - Global Weather Service",
  "description": "Chamada a um serviço SOAP público com autenticação básica",
  "taskType": "SOAP_CALL",
  "status": "INACTIVE",
  "cronExpression": "0 0 9 * * ?",
  "maxRetries": 2,
  "retryDelaySeconds": 90,
