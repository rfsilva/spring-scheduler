{
  "name": "REST API Secure - Credenciais Corretas",
  "description": "Chamada à nossa API REST segura (rest-api-secure) com credenciais corretas",
  "taskType": "REST_CALL",
  "status": "INACTIVE",
  "cronExpression": "0 0/20 * * * ?",
  "maxRetries": 2,
  "retryDelaySeconds": 60,
  "restTaskConfig": {
    "url": "http://rest-api-secure:8081/api/auth/signin",
    "method": "POST",
    "headers": "Content-Type: application/json\nAccept: application/json",
    "body": "{\"username\":\"admin\",\"password\":\"admin123\"}",
    "authType": "BASIC",
    "username": "admin",
    "password": "admin123",
    "connectTimeoutSeconds": 15,
    "readTimeoutSeconds": 15
  }
}